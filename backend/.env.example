# Golden Food Bowl - Production AWS Backend Environment Variables
# Copy this file to .env for local testing or set these variables in AWS App Runner.

# Server Environment & Port
NODE_ENV=development
PORT=8080

# PostgreSQL Database Connection URL (AWS RDS PostgreSQL)
# Format: postgresql://<username>:<password>@<rds_endpoint>:5432/<database_name>?schema=public
DATABASE_URL=postgresql://postgres:GoldenBowl2026!@goldenbowl-db.cxxxxxxxxx.eu-north-1.rds.amazonaws.com:5432/goldenbowl?schema=public

# AWS Region & S3 Private Bucket
AWS_REGION=eu-north-1
AWS_S3_BUCKET=goldenbowl-media-990565447037
AWS_CLOUDFRONT_URL=https://d1111111111111.cloudfront.net

# AWS Cognito Authentication Configuration
COGNITO_USER_POOL_ID=eu-north-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=eu-north-1

# Razorpay Payment Gateway Testing Credentials
RAZORPAY_KEY_ID=rzp_test_TWMl8a3GZGEgds
RAZORPAY_KEY_SECRET=y5NHIs1oZ6w0jvG37FKiSTSc


# Allowed Frontend Origins (CORS Security)
